# Copy to .env.local for local development, and set the same values in Vercel → Project → Settings → Environment Variables.
# Everything is optional locally: with nothing set the app runs on an embedded database in fixture (test) mode.

# ---- Document AI fallback chain (all free tiers) ------------------------------------------------
GEMINI_API_KEY=                                  # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite             # fast primary reader
GEMINI_FALLBACK_MODEL=gemini-3.5-flash          # backup + second opinion on uncertain fields
OPENROUTER_API_KEY=                              # https://openrouter.ai/keys (free models: 50 req/day)
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free   # free vision models with JSON output, tried in order
CF_ACCOUNT_ID=                                   # Cloudflare dashboard → Workers AI
CF_API_TOKEN=                                    # token with "Workers AI: Read" permission
WORKERS_AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# AI_PROVIDERS=gemini,gemini-lite,openrouter,workers-ai,regex   # order override (for fallback demos)
# EXTRACTOR=fixture                              # offline test mode (labelled in the UI)
# AI_EMAIL_COPY=off                              # disable AI-worded email intros

# ---- Supabase (database, document storage, realtime) -------------------------------------------
DATABASE_URL=                                    # Settings → Database → Connection string → Transaction pooler (port 6543)
SUPABASE_URL=                                    # Settings → API → Project URL
SUPABASE_SERVICE_ROLE_KEY=                       # Settings → API → service_role (server only!)
NEXT_PUBLIC_SUPABASE_URL=                        # same as SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=                   # Settings → API → anon public (used only for realtime pings)
SUPABASE_BUCKET=vendor-documents

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=




# ---- Auth (one-click demo login) ---------------------------------------------------------------
AUTH_SECRET=                                     # long random string; required in production
# DEMO_REVIEWER_NAME=Priya Nair
# DEMO_CONTROLLER_NAME=Rahul Mehta

# ---- Email: n8n is the email layer, SMTP is the backup ---------------------------------------------
N8N_WEBHOOK_URL=                                 # production URL of the Webhook node in n8n/vendoriq-communications.json
N8N_SHARED_SECRET=                               # same value as REPLACE_WITH_SHARED_SECRET in both n8n workflows
SMTP_USER=                                       # Gmail address of the onboarding inbox
SMTP_PASS=                                       # Gmail App Password (Google Account → Security → 2-Step → App passwords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
REMINDER_AFTER_MINUTES=2                         # demo timing; days in real life
MAX_REMINDERS=2
EMAIL_OVERRIDE_TO=                               # optional: deliver every vendor email to this inbox (safe demos)
PROCUREMENT_EMAIL=                               # optional: "review needed" alerts

# ---- Intake channels -----------------------------------------------------------------------------
INTAKE_SHARED_SECRET=                            # Google Form Apps Script + seed script use this
NEXT_PUBLIC_INTAKE_EMAIL=                        # shown on the portal: "email your documents to …"
NEXT_PUBLIC_GOOGLE_FORM_URL=                     # shown on the portal
TURNSTILE_SECRET_KEY=                            # Cloudflare → Turnstile → site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Misc ------------------------------------------------------------------------------------------
APP_URL=                                         # public base URL (emails + n8n callbacks); defaults to request origin
STAGE_PACING_MS=350                              # pause between pipeline stages so the live view is followable
